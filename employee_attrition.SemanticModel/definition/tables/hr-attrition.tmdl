table hr-attrition
	lineageTag: c9b2eef7-fc8a-4d32-91f0-9517b9c1ff6c

	measure Headcount = COUNT('hr-attrition'[employee_id])
		formatString: 0
		lineageTag: 117948ce-9b34-4a17-98f8-5c03719252b3

	measure Exits = CALCULATE(COUNTROWS('hr-attrition'), 'hr-attrition'[attrition_flag] = "Yes")
		formatString: 0
		lineageTag: 30a7ffa2-137b-4a2d-aa70-897b2fff2a45

	measure 'Attrition Rate' = COALESCE(DIVIDE([Exits], [Headcount]), 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 50b1e47d-4f03-43f4-a1d5-c945dbbebe84

	measure 'Worst Department' = VAR RankedDepartment = TOPN(1, VALUES('hr-attrition'[department]), [Attrition Rate], DESC) RETURN MAXX(RankedDepartment, 'hr-attrition'[department])
		lineageTag: 17724dc6-1e0a-46ef-9ad7-8beee913d426

	column employee_id
		dataType: string
		lineageTag: 426869f2-527f-4b2f-ba81-10d57f15ccf9
