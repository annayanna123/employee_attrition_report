	partition hr-attrition = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Users\Anna May\Downloads\FANRBF\Datasets\hr-attrition.csv"), [Delimiter = ",", Columns = 10, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"employee_id", type text}, {"department", type text}, {"job_role", type text}, {"hire_date", type date}, {"exit_date", type date}, {"monthly_salary", Int64.Type}, {"age", Int64.Type}, {"gender", type text}, {"regular_overtime", type text}, {"job_satisfaction", Int64.Type}}, "en-US"),
				  #"Added custom" = Table.TransformColumnTypes(Table.AddColumn(#"Changed column type", "attrition_flag", each if [exit_date] <> null and [exit_date] <> "" then "Yes" else "No"), {{"attrition_flag", type text}}),
				  #"Inserted conditional column" = Table.AddColumn(#"Added custom", "salary_band", each if [monthly_salary] < 22000 then "below 22k" else if [monthly_salary] < 32000 then "22k to 32k" else if [monthly_salary] < 45000 then "32k to 45k" else if [monthly_salary] > 45000 then "45k and up" else ""),
				  #"Inserted conditional column 1" = Table.AddColumn(#"Inserted conditional column", "age_range", each if [age] < 29 then "Young Adults" else if [age] < 44 then "Adults" else if [age] < 59 then "Middle-aged Adults" else if [age] > 59 then "Senior Adults" else "")
				in
				  #"Inserted conditional column 1"

	annotation PBI_ResultType = Table

